@* Partial: Sección Tecnologías *@

<!-- Encabezado actualizado para que coincida perfectamente con Educación y Certificaciones -->
<header class="section-header" id="tecnologias">
    <div class="container">
        <div class="row">
            <div class="col-12 col-md-8">
                <h2 class="section-title">Tecnologías</h2>
                <div class="section-divider"></div>
            </div>
            <div class="col-12 col-md-4 text-md-end" style="align-self:center;">
                <small class="section-sub">HERRAMIENTAS Y STACKS</small>
            </div>
        </div>
    </div>
</header>

<section class="container tech-section" style="padding:24px 15px 60px;">
    <div class="row align-items-center">

        <!-- Lado Izquierdo: Textos -->
        <div class="col-12 col-md-6 mb-5 mb-md-0">
            <p style="opacity:.85;max-width:900px;margin:0 auto 24px 0;color:rgba(230,238,248,0.85);">
                Herramientas y stacks con las que he trabajado.
            </p>

            <!-- Se agregó mb-4 para dar más "aire" y color al h5 -->
            <div class="tech-category mb-4">
                <h5 style="color: #ffd166; font-weight: 600; margin-bottom: 10px;">Bases de Datos & Modelado</h5>
                <p class="muted" style="margin-bottom: 4px;">Motores: SQL Server · PostgreSQL · MariaDB</p>
                <p class="muted" style="margin-bottom: 4px;">Gestión: Diseño de esquemas, consultas SQL y control de migraciones</p>
                <p class="muted" style="margin-bottom: 0;">Enfoque: Traducción de reglas de negocio en estructuras eficientes</p>
            </div>

            <!-- Se corrigió a "Aseguramiento de Calidad" y se agregó color al h5 -->
            <div class="tech-category mb-4">
                <h5 style="color: #ffd166; font-weight: 600; margin-bottom: 10px;">Aseguramiento de Calidad (QA) & Arquitectura</h5>
                <p class="muted" style="margin-bottom: 4px;">Pruebas unitarias (JUnit), code review, validación y debugging</p>
                <p class="muted" style="margin-bottom: 0;">Levantamiento de requerimientos y documentación técnica</p>
            </div>

            <!-- Los "Chips" (botones) separados un poco más del texto de arriba -->
            <div class="d-flex gap-3 flex-wrap mt-4">
                <span class="tech-chip">Clean Code</span>
                <span class="tech-chip">Refactorización</span>
                <span class="tech-chip">Patrones</span>
                <span class="tech-chip">CI / CD</span>
            </div>
        </div>

        <!-- Lado Derecho: Iconos -->
        <div class="col-12 col-md-6">
            <div class="tech-logos-grid d-flex flex-wrap gap-3" style="align-items:center;">

                <div class="tech-item d-flex align-items-center">
                    <img class="tech-logo" src="https://cdn.jsdelivr.net/gh/devicons/devicon/icons/csharp/csharp-original.svg" alt="C#" />
                    <span>C#</span>
                </div>

                <div class="tech-item d-flex align-items-center">
                    <img class="tech-logo" src="https://cdn.jsdelivr.net/gh/devicons/devicon/icons/java/java-original.svg" alt="Java" />
                    <span>Java</span>
                </div>

                <div class="tech-item d-flex align-items-center">
                    <img class="tech-logo" src="https://cdn.jsdelivr.net/gh/devicons/devicon/icons/typescript/typescript-original.svg" alt="TypeScript" />
                    <span>TypeScript</span>
                </div>

                <div class="tech-item d-flex align-items-center">
                    <img class="tech-logo" src="https://cdn.jsdelivr.net/gh/devicons/devicon/icons/microsoftsqlserver/microsoftsqlserver-plain.svg" alt="SQL Server" />
                    <span>SQL Server</span>
                </div>

                <div class="tech-item d-flex align-items-center">
                    <img class="tech-logo" src="https://cdn.jsdelivr.net/gh/devicons/devicon/icons/postgresql/postgresql-original.svg" alt="PostgreSQL" />
                    <span>PostgreSQL</span>
                </div>

                <div class="tech-item d-flex align-items-center">
                    <img class="tech-logo" src="https://cdn.jsdelivr.net/gh/devicons/devicon/icons/mariadb/mariadb-original.svg" alt="MariaDB" />
                    <span>MariaDB</span>
                </div>

                <div class="tech-item d-flex align-items-center">
                    <img class="tech-logo devicon" src="https://cdn.jsdelivr.net/gh/devicons/devicon/icons/dot-net/dot-net-plain.svg" alt="ASP.NET" />
                    <span>ASP.NET</span>
                </div>

                <div class="tech-item d-flex align-items-center">
                    <img class="tech-logo" src="https://cdn.jsdelivr.net/gh/devicons/devicon/icons/spring/spring-original.svg" alt="Spring" />
                    <span>Spring Boot</span>
                </div>

                <div class="tech-item d-flex align-items-center">
                    <img class="tech-logo" src="https://cdn.jsdelivr.net/gh/devicons/devicon/icons/react/react-original.svg" alt="React" />
                    <span>React</span>
                </div>

                <div class="tech-item d-flex align-items-center">
                    <img class="tech-logo" src="https://cdn.jsdelivr.net/gh/devicons/devicon/icons/tailwindcss/tailwindcss-original.svg" alt="Tailwind" />
                    <span>Tailwind CSS</span>
                </div>

                <div class="tech-item d-flex align-items-center">
                    <img class="tech-logo" src="https://cdn.jsdelivr.net/gh/devicons/devicon/icons/git/git-original.svg" alt="Git" />
                    <span>Git</span>
                </div>

                <div class="tech-item d-flex align-items-center">
                    <img class="tech-logo" src="https://cdn.jsdelivr.net/gh/devicons/devicon/icons/docker/docker-original.svg" alt="Docker" />
                    <span>Docker</span>
                </div>

            </div>
        </div>
    </div>
</section>